{
  "rules": {
    "status": {
      ".read": true,
      "mac": { ".write": "auth.uid === 'IHyYvDFrQBZRHNxAoqiDkBHoByC2'" }
    },

    "open": {
      ".read": "auth.uid === 'IHyYvDFrQBZRHNxAoqiDkBHoByC2'",

      "$client": {
        ".validate": "$client.length >= 20",

        "jobs": {
          ".read": "auth.uid === 'IHyYvDFrQBZRHNxAoqiDkBHoByC2'",
          ".write": true,
          "$job": {
            "model": { ".validate": "newData.val() == 'g-micro' || newData.val() == 'g-images'" },
            "text": { ".validate": "newData.isString() && newData.val().length <= 2000" },
            "image": { ".validate": "newData.isString() && newData.val().length <= 400000" },
            "at": { ".validate": "newData.isNumber()" },
            "history": { ".validate": "true" },
            "cancel": { ".validate": "newData.isBoolean()" },
            "$other": { ".validate": "false" }
          }
        },

        "out": {
          ".read": true,
          ".write": "auth.uid === 'IHyYvDFrQBZRHNxAoqiDkBHoByC2'"
        },

        "$other": { ".validate": "false" }
      }
    }
  }
}
